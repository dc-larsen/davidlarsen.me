---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/Nav.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  ogType?: 'website' | 'article'
}

const {
  title,
  description = 'Customer support & success leader in Baltimore. Supporting teams, building processes, and solving problems.',
  image = '/images/pro.png',
  ogType = 'website',
} = Astro.props

const site = Astro.site ?? new URL('https://davidlarsen.me')
const canonical = new URL(Astro.url.pathname, site).href
const socialImage = new URL(image, site).href
const fullTitle = title ? `${title} – David Larsen` : 'David Larsen'
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=7" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=7" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=7" />
    <link rel="alternate" type="application/rss+xml" title="David Larsen" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="David Larsen" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@davidlarsen" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <Font cssVariable="--font-source-sans" preload />
    <Font cssVariable="--font-source-serif" preload />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-primary">
    <a href="#content" class="skip-link">Skip to content</a>
    <header class="relative z-40">
      <Nav />
    </header>
    <main id="content" class="mx-auto max-w-7xl px-4 py-8 pb-16" transition:animate="fade">
      <slot />
    </main>
    <footer class="site-footer">
      <span class="flex items-center gap-1">
        Made with
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        using
        <a class="underline decoration-transparent hover:text-secondary hover:decoration-current" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        in Baltimore, MD
      </span>
      <span>Updated: {year}</span>
    </footer>
  </body>
</html>
