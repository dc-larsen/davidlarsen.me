---
import Base from '../../layouts/Base.astro'
import BlogCard from '../../components/BlogCard.astro'
import { formatDate, getPosts, postSlug, readingMinutes } from '../../lib/posts'

const posts = await getPosts()
const featured = posts[0]
const rest = posts.slice(1)
const categories = ['All', ...new Set(posts.map(post => post.data.category))]
const featuredMinutes = featured ? readingMinutes(featured.body ?? '', featured.data.readTime) : 0
---

<Base
  title="Blog"
  description="David Larsen's blog on customer support, team leadership, technology, and professional insights from Baltimore."
>
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <h1 class="mb-4 text-4xl font-bold text-primary">Blog</h1>
      <p class="mx-auto max-w-2xl text-xl text-gray-600">Thoughts on work and whatever I find interesting.</p>
    </div>

    {
      featured && (
        <div class="mb-16">
          <h2 class="mb-6 text-2xl font-semibold text-primary">Featured Post</h2>
          <div class="overflow-hidden rounded-lg bg-white shadow-xl">
            <div class="md:flex md:min-h-[400px]">
              <div class="md:flex md:w-1/2">
                <a href={`/blog/${postSlug(featured)}`} class="block w-full">
                  <img
                    src={featured.data.image}
                    alt={featured.data.title}
                    class="h-64 w-full object-cover transition-transform duration-300 hover:scale-105 md:h-full md:min-h-[400px]"
                  />
                </a>
              </div>
              <div class="p-8 md:flex md:w-1/2 md:flex-col md:justify-center">
                <div class="mb-4 flex items-center text-sm text-gray-500">
                  <span class="mr-4 rounded-full bg-secondary px-3 py-1 text-xs font-medium text-white">
                    {featured.data.category}
                  </span>
                  <time datetime={featured.data.date}>{formatDate(featured.data.date)}</time>
                  <span class="mx-2">•</span>
                  <span>{featuredMinutes} min read</span>
                </div>
                <a href={`/blog/${postSlug(featured)}`} class="block">
                  <h3 class="mb-4 text-2xl font-bold text-primary transition-colors hover:text-secondary">
                    {featured.data.title}
                  </h3>
                </a>
                <p class="mb-6 text-gray-600">{featured.data.excerpt}</p>
                {featured.data.tags.length > 0 && (
                  <div class="mb-6 flex flex-wrap gap-2">
                    {featured.data.tags.map(tag => (
                      <span class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">#{tag}</span>
                    ))}
                  </div>
                )}
                <a
                  href={`/blog/${postSlug(featured)}`}
                  class="inline-flex items-center rounded-lg bg-secondary px-6 py-3 font-medium text-white transition-colors hover:bg-secondary/90"
                >
                  Read Full Article
                  <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      )
    }

    <div class="mb-8 flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex flex-wrap gap-2" id="blog-categories">
        {
          categories.map(category => (
            <button
              type="button"
              data-category={category}
              class:list={[
                'rounded-full px-4 py-2 text-sm font-medium transition-colors duration-200',
                category === 'All' ? 'bg-secondary text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200',
              ]}
            >
              {category}
            </button>
          ))
        }
      </div>
      <div class="relative">
        <input
          id="blog-search"
          type="search"
          placeholder="Search posts..."
          class="rounded-lg border border-gray-300 py-2 pr-4 pl-10 focus:border-transparent focus:ring-2 focus:ring-secondary focus:outline-none"
        />
        <svg class="absolute top-2.5 left-3 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <div id="blog-grid" class="mb-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {rest.map(post => <BlogCard post={post} />)}
    </div>

    <div id="blog-empty" class="hidden py-12 text-center">
      <h3 class="mb-2 text-xl font-medium text-gray-600">No posts found</h3>
      <p class="text-gray-500">Try adjusting your search or filter criteria.</p>
    </div>
  </div>
</Base>

<script is:inline src="/scripts/blog.js"></script>
