---
import Base from '../layouts/Base.astro'
import Terminal from '../components/Terminal.astro'

const links = [
  {
    href: 'https://www.linkedin.com/in/david-larsen-404622143/',
    label: 'LinkedIn Profile',
    title: 'Connect on LinkedIn',
    icon: 'linkedin',
  },
  {
    href: 'https://github.com/dc-larsen',
    label: 'GitHub Profile',
    title: 'View GitHub Projects',
    icon: 'github',
  },
  {
    href: 'https://www.flickr.com/photos/203372618@N08/',
    label: 'Flickr Photos',
    title: 'Photography on Flickr',
    icon: 'flickr',
  },
  {
    href: 'https://open.spotify.com/user/dc2larsen',
    label: 'Spotify Profile',
    title: 'Music on Spotify',
    icon: 'spotify',
  },
  {
    href: 'https://worldofwarcraft.blizzard.com/en-us/character/us/proudmoore/fizzl%C3%AA/',
    label: 'World of Warcraft Character',
    title: 'WoW Character Profile',
    icon: 'wow',
  },
]
---

<Base title="Home">
  <div class="flex min-h-[80vh] flex-col items-center justify-center gap-8 lg:flex-row">
    <div class="text-center lg:w-1/3 lg:text-left">
      <img class="pro-pic mx-auto mb-6 lg:mx-0" alt="David Larsen" src="/images/pro.png?v=3" width="175" height="175" />
      <h1 class="mb-4 text-4xl font-bold text-primary lg:text-5xl">Hey there! I'm David.</h1>
      <p class="mb-8 text-lg leading-relaxed text-gray-600 lg:text-xl">
        Technical Account Manager @ <img src="/images/socket.png" alt="Socket" class="mx-1 inline-block h-7 w-auto align-text-bottom" />, helping customers build securely and scale with confidence. Outside of work, you'll usually find me exploring Baltimore's food scene or traveling with friends and family.
      </p>
      <div class="mb-8 flex justify-center space-x-4 lg:justify-start">
        {
          links.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary transition-colors hover:text-secondary"
              aria-label={link.label}
              title={link.title}
            >
              {link.icon === 'linkedin' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                </svg>
              )}
              {link.icon === 'github' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              )}
              {link.icon === 'flickr' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="3" />
                  <circle cx="8.5" cy="12" r="2.5" fill="currentColor" stroke="none" />
                  <circle cx="15.5" cy="12" r="2.5" fill="currentColor" stroke="none" />
                </svg>
              )}
              {link.icon === 'spotify' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M7 9c2 -1 6 -2 10 .5" />
                  <path d="M8 11.973c2.5 -1.473 5.5 -.973 7.5 .527" />
                  <path d="M9 15c1.5 -1 4 -1 5 .5" />
                </svg>
              )}
              {link.icon === 'wow' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 11h4m-2-2v4m6-1h.01M18 10h.01" />
                  <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
    <div class="hidden w-full lg:block lg:w-2/3">
      <Terminal />
    </div>
  </div>
</Base>
